{
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/theme", "destination": "/#settings/general", "permanent": false },
    { "source": "/language", "destination": "/#settings/general", "permanent": false },
    { "source": "/sound", "destination": "/#settings/speech", "permanent": false },
    { "source": "/usage", "destination": "/#settings/account", "permanent": false },
    { "source": "/subscription", "destination": "/#settings/account", "permanent": false }
  ],
  "rewrites": [
    { "source": "/c/:chatId*", "destination": "/index.html" },
    { "source": "/g/:gptId*", "destination": "/index.html" },
    { "source": "/share/:shareId*", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/settings/:tab*", "destination": "/index.html" },
    { "source": "/auth/login", "destination": "/login.html" },
    { "source": "/auth/signup", "destination": "/login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/", "destination": "/login.html" },
    { "source": "/signup", "destination": "/login.html" },
    { "source": "/signup/", "destination": "/login.html" },
    { "source": "/pricing", "destination": "/plans.html" },
    { "source": "/pricing/", "destination": "/plans.html" },
    { "source": "/plans", "destination": "/plans.html" },
    { "source": "/plans/", "destination": "/plans.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/chat/(.*)", "destination": "/api/index.js" },
    { "source": "/redeem/(.*)", "destination": "/api/index.js" },
    { "source": "/search/(.*)", "destination": "/api/index.js" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/app", "destination": "/download.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/personalization", "destination": "/personalization.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/redeem", "destination": "/redeem.html" }
  ]
}
