# ==============================================================================
# ALORA AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the '.env' file or any credentials to Git!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas or Local MongoDB)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/alokpoth_ai?retryWrites=true&w=majority

# Authentication (JWT Secret Key - 64+ characters recommended)
JWT_SECRET=your_super_secret_jwt_key_here_change_me

# Google & Discord OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# AI Model Provider API Keys
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Other AI Providers (Optional)
BAI_API_KEY=your_bai_api_key_here
VYCE_API_KEY=your_vyce_api_key_here
